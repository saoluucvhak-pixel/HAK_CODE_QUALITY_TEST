{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HAK Agent Finding V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "rule",
    "severity",
    "file",
    "message",
    "verification_status"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "medium",
        "high",
        "critical"
      ]
    },
    "file": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "suggested_fix": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verification_status": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL"
      ]
    }
  }
}
